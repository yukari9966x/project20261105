{
  "name": "kats-superapp",
  "private": true,
  "version": "1.0.0",
  "description": "국가기술표준원 슈퍼앱 — 표준·인증·제품안전·해외규제를 한 창구로 (2026 산업부 AI 활용 경진대회 시제품)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run prepare-data && vite",
    "fetch-data": "tsx scripts/fetch-safety.ts",
    "prepare-data": "tsx scripts/build-index.ts && tsx scripts/copy-pyodide.ts",
    "build": "npm run prepare-data && tsc --noEmit -p tsconfig.json && vite build && tsx scripts/check-size.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:engine": "python3 -m unittest discover -s engine/tests -t engine",
    "test:e2e": "node tests/e2e/run-e2e.mjs"
  },
  "dependencies": {
    "minisearch": "7.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "pyodide": "314.0.7",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
